# retention-bench environment.
# Copy to `.env` (gitignored) and fill in. `run.sh` auto-sources `.env`.

# REQUIRED — API key for the OpenAI-compatible endpoint (OpenRouter by default).
# The text SUTs and the judge refuse to start without it.
OPENROUTER_API_KEY=

# Optional — OpenAI-compatible base URL (default: https://openrouter.ai/api/v1).
# Point this at any OpenAI-compatible gateway to use a different provider.
# RETENTION_BENCH_BASE_URL=https://openrouter.ai/api/v1

# Optional — per-SUT model overrides (defaults shown).
# NO_STATE_MODEL=deepseek/deepseek-v4-flash
# NOTES_LLM_MODEL=deepseek/deepseek-v4-flash
# NAIVE_RAG_MODEL=deepseek/deepseek-v4-flash

# Optional — judge model used by the scorer (default shown).
# RETENTION_BENCH_JUDGE_MODEL=moonshotai/kimi-k2.6
